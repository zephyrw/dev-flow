{
  "name": "devflow",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "build:host": "node scripts/build-host.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/apps/api/src/main.js",
    "cli": "tsx packages/cli/src/main.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:live:agy": "tsx tests/live/agy-workflow.ts",
    "test:live:resume-stop": "tsx tests/live/agy-resume-stop.ts",
    "test:live:opentabs": "tsx tests/live/browser-gateway.ts",
    "schemas": "tsx scripts/export-schemas.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "open": "node dist/packages/service/src/open.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "fast-xml-parser": "^5.3.0",
    "fastify": "^5.6.0",
    "jsdom": "29.0.1",
    "mermaid": "^11.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.2",
    "prettier": "3.6.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "4.1.11"
  }
}
