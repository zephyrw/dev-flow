{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"], "jsx": "react-jsx", "strict": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "noUncheckedIndexedAccess": true, "forceConsistentCasingInFileNames": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["apps", "packages", "tests", "vitest.config.ts", "playwright.config.ts"]
}
