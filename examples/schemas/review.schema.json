{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "passed",
        "changes_required",
        "need_user"
      ]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "repo_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "trigger": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "consequence": {
            "type": "string"
          },
          "relation_to_change": {
            "type": "string",
            "enum": [
              "introduced",
              "in_scope",
              "historical",
              "suggestion"
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "confirmed",
              "false_positive",
              "out_of_scope"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": {}
      }
    },
    "unresolved_questions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repair_document": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    },
    "quality": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "function_impact": {
              "default": "none",
              "type": "string",
              "enum": [
                "none",
                "changed",
                "uncertain"
              ]
            },
            "summary": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "function_impact"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "verdict",
    "findings",
    "unresolved_questions"
  ],
  "additionalProperties": false
}
