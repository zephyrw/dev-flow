{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "default": 2,
      "type": "number",
      "const": 2
    },
    "server": {
      "type": "object",
      "properties": {
        "host": {
          "default": "127.0.0.1",
          "type": "string",
          "const": "127.0.0.1"
        },
        "port": {
          "default": 4810,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 65535
        },
        "human_origin": {
          "default": "http://localhost:4810",
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "host",
        "port",
        "human_origin"
      ],
      "additionalProperties": false
    },
    "retain_services_on_stop": {
      "default": false,
      "type": "boolean"
    },
    "storage_root": {
      "default": ".devflow",
      "type": "string"
    },
    "agy_accounts": {
      "type": "object",
      "properties": {
        "standalone_model_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_auto_switch": {
          "default": true,
          "type": "boolean"
        },
        "pause_managed_for_manual_switch": {
          "default": true,
          "type": "boolean"
        },
        "switch_gap_seconds": {
          "default": 3,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "reset_clock_skew_seconds": {
          "default": 60,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "probe_timeout_seconds": {
          "default": 30,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "switch_timeout_seconds": {
          "default": 300,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_candidates_per_operation": {
          "default": 20,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "local_snapshot_stale_hours": {
          "default": 24,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maintenance": {
          "type": "object",
          "properties": {
            "timezone": {
              "default": "Asia/Shanghai",
              "type": "string"
            },
            "local_report_time": {
              "default": "17:30",
              "type": "string"
            },
            "night_start": {
              "default": "20:00",
              "type": "string"
            },
            "night_end": {
              "default": "08:00",
              "type": "string"
            },
            "refresh_verified_max_age_hours": {
              "default": 24,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "auto_network_check": {
              "default": false,
              "type": "boolean",
              "const": false
            }
          },
          "required": [
            "timezone",
            "local_report_time",
            "night_start",
            "night_end",
            "refresh_verified_max_age_hours",
            "auto_network_check"
          ],
          "additionalProperties": false
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "standalone_model_id",
        "workflow_auto_switch",
        "pause_managed_for_manual_switch",
        "switch_gap_seconds",
        "reset_clock_skew_seconds",
        "probe_timeout_seconds",
        "switch_timeout_seconds",
        "max_candidates_per_operation",
        "local_snapshot_stale_hours",
        "maintenance",
        "enabled"
      ],
      "additionalProperties": false
    },
    "workspace_root": {
      "default": ".devflow/worktrees",
      "type": "string"
    },
    "models": {
      "type": "object",
      "properties": {
        "executor": {
          "default": "gemini-3.8-flash-high",
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "default": "gpt-6-astra",
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "default": "high",
          "type": "string",
          "const": "high"
        },
        "agy_executable": {
          "default": "agy",
          "type": "string"
        },
        "codex_executable": {
          "default": "codex",
          "type": "string"
        },
        "codex_prefix_args": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "executor",
        "reviewer",
        "effort",
        "agy_executable",
        "codex_executable",
        "codex_prefix_args"
      ],
      "additionalProperties": false
    },
    "scheduler": {
      "type": "object",
      "properties": {
        "executors": {
          "description": "已弃用，仅兼容旧配置，不限制任务并行数量",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "reviewers": {
          "description": "已弃用，仅兼容旧配置，不限制任务并行数量",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "heavy_tests": {
          "description": "已弃用，仅兼容旧配置，不限制测试并行数量",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "live_environments": {
          "description": "已弃用，仅兼容旧配置，不限制验证环境数量",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "aging_minutes": {
          "default": 10,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "aging_minutes"
      ],
      "additionalProperties": false
    },
    "ports": {
      "type": "object",
      "properties": {
        "frontend": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 65535
            },
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 65535
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "backend": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 65535
            },
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 65535
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "bind_retries": {
          "default": 5,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "bind_retries"
      ],
      "additionalProperties": false
    },
    "opentabs": {
      "type": "object",
      "properties": {
        "endpoint": {
          "default": "http://127.0.0.1:9515/mcp",
          "type": "string",
          "format": "uri"
        },
        "secret_file": {
          "default": "",
          "type": "string"
        },
        "allowed_test_origins": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "required": [
        "endpoint",
        "secret_file",
        "allowed_test_origins"
      ],
      "additionalProperties": false
    },
    "timeouts": {
      "type": "object",
      "properties": {
        "agent_minutes": {
          "default": 60,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "idle_minutes": {
          "default": 10,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "stop_seconds": {
          "default": 5,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "heartbeat_seconds": {
          "default": 5,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "agent_minutes",
        "idle_minutes",
        "stop_seconds",
        "heartbeat_seconds"
      ],
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "logs_days": {
          "default": 30,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "failed_logs_days": {
          "default": 90,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "evidence_days": {
          "default": 180,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "logs_days",
        "failed_logs_days",
        "evidence_days"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "server",
    "retain_services_on_stop",
    "storage_root",
    "agy_accounts",
    "workspace_root",
    "models",
    "scheduler",
    "ports",
    "opentabs",
    "timeouts",
    "retention"
  ],
  "additionalProperties": false
}
